# host modules imported from a domain dir (dog_host.py …)
__pycache__/
*.pyc
*.egg-info/

# the domain agents' surprise records (records sink, e2e-workflow s-143c3088): the hand-off
# between the agent and the loop console on one host, not catalog content
domains/*/records/

# the packages' bundles (python -m metis.kernel.artifact <n>: ground.wire + sidecar.json,
# runtime-binding s-9054df5d step 2): built from the program plus its extensions, never committed
domains/*/build/
