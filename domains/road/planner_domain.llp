% planner_domain — the SLOW road domain (road-world s-e812715d step 2; framework L3): route progress, lane choice, zone
% entry and yield, the zipper, the walker. It beats every tenth world step (1 s) and holds the controls while the
% responder does not. The keep-table of the parked catalog (postmortem §4), once each over roles:
%   mleft/mright      a lane change only to an adjacent lane, its lead and follower safe (`change`, adjacent(D))
%   myield, zentry    a zone not the ego's to take, someone coming: stop before its line (`yield_zone`): RSS's
%                     "right of way is given, not taken" — the host's near is the ego's stopping reach, so the ego
%                     still can stop there
%   zram/zshare       crossing axes yield (conflict), a merge's share by turns (share)
%   menter/mskip      the zipper: at a merge, not the ego's turn and the other lane comes: let it in (`yield_merge`)
%   xwram             a walker at the crossing ahead: stop before it (`yield_walker`)
%   maccel/mbrake     the longitudinal commands: accel, keep, and the planner's gentle brake behind a closing lead
%                     (brake_min_correct; the proper response's brake_min is the responder's)
%   mcross            RSS rule 5, form B (right of way is given, not taken): no accel toward a conflict zone while a car
%                     on its crossing lane still moves; keep (the responder's brake_min if it comes to that) until it
%                     stands or has passed, then accel. If its time at the zone overlaps the ego's, a soft brake keeps the
%                     ability to stop short of the line, so the responder's response is still there to give
%   the surface       hard safety first, then progress, ties to the incumbent: the SAFETY stage's yields first; only
%                     when none fires (`now` still there and the controls held: decide's one `go`) the PROGRESS stage's
%                     change, accel, keep, a change preferred
%                     to following a slow lead (keep_lead's static weight)
% The geometry is the host's (rule 2): it says classes (zone_at, zprio, zbusy, lead_slow …), the rules decide.
% the road FAMILY's planner (road-family s-f62c0ed8, 2026-11-01): the lane change rule is change.llp, the car's unit; the
% neighbour-lane and roomy facts stay here (declarations in place, so the car's bundle is the one-file planner's).
catalog planner_domain 1.
provenance text "the road's plan: progress, lane choice, zone entry and yield, the zipper, the walker" "2026-10-26".
layers (dyn).
stages (safety progress).
types (obj side zone zclass prio walk resp).   % completed by the instance (capacity.llp)
include "iface/protocol_domain.llp".
namespace planner produce (dyn).
% the situation layer and the host's classes (metis-worlds road/world/road_facts.py)
pred safe_long(obj) : planner.
pred safe_lat(obj) : planner.
pred adjacent(side) : planner.              % a same-direction lane on that side
pred role_empty(obj) : planner.             % a role the host does not fill: nobody there it saw (no class, no safety fact; spec 20 §2)
pred changing(side) : planner.
pred settled(side) : planner.               % no change runs, and the ego did not leave that side lately (the host's)
pred below_target : planner.                % the ego against what it wants: min(pace, the lane's limit, a stop wish's 0), exclusive
pred at_target : planner.
pred above_target : planner.
family target (below_target at_target above_target).   % the host's exclusive reading (spec/00 §5a): a rule reads a member, never writes one
pred change_reason(side) : planner.         % a person's wish to change to that side (road_wishes.py); a slow lead's pass is change.llp's own reason
pred lead_slow : planner.                   % a slow lead within reach ahead: the truth of one, never a wish
% the two gap records' vocabulary (road-scenarios s-e23be780 step 3, steps/road-gap-vocabulary-architect.md, the architect's word):
% the host states it every tick, in the EGO's heading frame (on the oncoming lane the route lane is the ego's right side)
pred lead_standing : planner.               % the lead stands within reach, not waiting at a zone or a light: an obstacle, not a queue (668e45)
pred oncoming(side) : planner.              % the lane on that side is the opposite direction's driving lane (lane_kind(D, none) beside it) (668e45)
pred oncoming_clear(side) : planner.        % that oncoming lane free and seen for the whole pass (the host's arithmetic; unseen is busy) (668e45)
pred oncoming_busy(side) : planner.
family oncoming_room (oncoming_clear oncoming_busy).   % stated only where oncoming(D) holds: exclusive per such side, the host's
pred emergency(obj) : planner.              % the role's mover is an emergency vehicle with its lights on: a class, never a belief (13b2f9)
pred lead_ok : planner.
pred accel_ok : planner.                    % a plan of full acceleration keeps the lead at a safe distance
pred accel_no : planner.
pred keep_ok : planner.                     % two plans at its speed keep the lead at a safe distance
pred keep_no : planner.
pred at_dest : planner.
pred zone_at(zone, zclass) : planner.       % where the ego is from the next zone (near: within its stopping reach)
pred zprio(zone, prio) : planner.           % who has the way at the zone: P is a VALUE of type prio, {ego, obj, same}: obj: the other has it (yields_to says where the ego yields)
pred can_stop(zone) : planner.
pred late(zone) : planner.
pred zfree(zone) : planner.
pred zbusy(zone) : planner.                 % someone inside or coming
pred zclear(zone) : planner.
pred seen_ahead : planner.                  % the ego's OWN way can be seen to its stopping reach, or to the first car on it: the holder's duty, range and occlusion alike
pred unseen_ahead : planner.
pred road_in_view(zone) : planner.          % where the zone's priority is not the ego's and no red or amber governs: its crossing lanes can be seen, back to where a car could still reach it (the yielder's duty, StVO 8(2))
pred road_hidden(zone) : planner.
pred stop_sign(zone) : planner.             % the next link has a stop sign: the host says inch_room there only after one standing tick at the line
pred inch_room(zone) : planner.             % … hidden, and it may go on to see: at a walk, room behind any lead, short of the crossing lane
pred inch_no(zone) : planner.
pred cross_settled(zone) : planner.         % every car on a crossing lane near the zone stands, or none is there
pred cross_unsettled(zone) : planner.       % one still moves: whether it yields is not yet seen
pred cross_overlap(zone) : planner.         % … its time at the zone overlaps the ego's, and another plan at this speed would lose the stop short
pred conflict(zone) : planner.              % crossing axes
pred share(zone) : planner.                 % a merge's
pred turn(zone) : planner.                  % the zipper: the ego's turn
pred wait_turn(zone) : planner.
pred holder(zone, obj) : planner.
pred crossing(obj, walk) : planner.         % the walker at the crossing ahead
pred now : planner.
% the planner's own
pred idle : planner.
pred busy : planner.
invariant mode (idle busy) : 1.                  % one of them at every reachable state: every rule keeps the sum (spec/00 §5a)
pred trip : planner.                        % the drive to the destination (the instance's)
pred go : planner.                          % this beat's progress decision is due (decide's: one a beat)
% the neighbour lanes' roles, by side (a lane change reads the target lane's lead and follower)
bwd side_lead(side, obj).
bwd side_follow(side, obj).
side_lead(left, leadleft).
side_lead(right, leadright).
side_follow(left, followleft).
side_follow(right, followright).
bwd closing_in(zclass).                     % where a yield applies
closing_in(near).
closing_in(at).
bwd yields_to(prio).                        % whose zone the ego yields at
yields_to(obj).
yields_to(same).
bwd soft(resp).                             % the planner's own braking (the responder's is brake_min)
soft(brake_min_correct).
bwd roomy(zclass).                          % where a lane change is allowed
roomy(none).
roomy(far).
stage safety {
  %% I drive on to my destination: I ask for the controls.
  drive [dyn] : idle * $trip -o busy * tick__active(planner) * tick__want(planner, controls).
  % >>> generated by metis.catalog.protocol_stub: the stop's cancels and the release's echo (regenerate, do not edit)
  %% Stopped: I drop my goal.
  cancel [dyn] : tick__cancel(planner) * busy -o idle.
  %% Stopped as I finished: nothing left to drop.
  cancel_none [dyn] : idle * tick__cancel(planner) -o idle.   % the race: its done and the stop in one director beat (path_pop, stop_cancel: the sampled order)
  %% I gave {R} back: I say which grant.
  released [dyn] : tick__release(planner, R) * $tick__gen(planner, R, G) -o tick__released(planner, R, G).
  % <<< generated
  %% I am there.
  arrive [dyn] : busy * trip * $at_dest -o idle * tick__done(planner) * tick__release(planner, controls).
  %% The zone ahead is not mine to take and someone comes: I stop before its line.
  yield_zone [dyn] : $busy * $tick__grant(planner, controls) * $zone_at(nextzone, C) * $closing_in(C) * $zprio(nextzone, P) * $yields_to(P) * $conflict(nextzone) * $zbusy(nextzone) * now -o ().
  %% The zone ahead is not mine to take, I cannot see its road, and I am too fast or have no room to go on: I stop before it.
  yield_hidden [dyn] : $busy * $tick__grant(planner, controls) * $zone_at(nextzone, C) * $closing_in(C) * $zprio(nextzone, P) * $yields_to(P) * $conflict(nextzone) * $road_hidden(nextzone) * $inch_no(nextzone) * now -o ().
  %% I still cannot see that road, and there is room: I go on at a walk to where I can; never up to the crossing lane.
  inch_hidden [dyn] : $busy * $tick__grant(planner, controls) * $zprio(nextzone, P) * $yields_to(P) * $conflict(nextzone) * $road_hidden(nextzone) * $inch_room(nextzone) * now -o ().
  %% A car at the zone ahead has not shown it yields, and we would be there together: I ease off, {R}, so I can still stop short.
  brake_cross [dyn] : $busy * $tick__grant(planner, controls) * $cross_overlap(nextzone) * $soft(R) * now -o ().
  %% The zone ahead is mine, but a car at it has not shown it yields and I am late for it: I ease off, {R}, rather than hold on.
  brake_cross_late [dyn] : $busy * $tick__grant(planner, controls) * $cross_unsettled(nextzone) * $late(nextzone) * $zprio(nextzone, ego) * $soft(R) * now -o ().
  %% I cannot see my own way as far as I would need to stop: I ease off, {R}.
  brake_unseen [dyn] : $busy * $tick__grant(planner, controls) * $unseen_ahead * $soft(R) * now -o ().
  %% A walker is at the crossing ahead: I stop before it.
  yield_walker [dyn] : $busy * $tick__grant(planner, controls) * $crossing(vru1, W) * $zone_at(nextzone, C) * $closing_in(C) * now -o ().
  %% The merge ahead: not my turn, and the other lane comes: I let it in.
  yield_merge [dyn] : $busy * $tick__grant(planner, controls) * $zone_at(nextzone, C) * $closing_in(C) * $share(nextzone) * $wait_turn(nextzone) * $zbusy(nextzone) * now -o ().
}
%% Nothing calls for a yield, the controls are mine: I go on with the plan.
qui decide [dyn] : safety * $tick__grant(planner, controls) * now -o progress * go.
stage progress {
  %% Below what I want, nothing slow ahead, room before the lead: I speed up.
  accel [dyn] : $busy * $tick__grant(planner, controls) * $below_target * $lead_ok * $accel_ok * $cross_settled(nextzone) * go -o ().
  %% Below what I want, but a car at the zone ahead has not shown it yields: I keep my speed until it does.
  keep_cross [dyn] : $busy * $tick__grant(planner, controls) * $below_target * $lead_ok * $accel_ok * $cross_unsettled(nextzone) * go -o ().
  %% Below what I want, but no room to speed up before the lead: I keep my speed.
  keep_gap [dyn] : $busy * $tick__grant(planner, controls) * $below_target * $lead_ok * $accel_no * $keep_ok * go -o ().
  %% At what I want: I keep my speed.
  keep_limit [dyn] : $busy * $tick__grant(planner, controls) * $at_target * $keep_ok * go -o ().
  %% Above what I want: I ease off, {R}.
  brake_target [dyn] : $busy * $tick__grant(planner, controls) * $above_target * $soft(R) * go -o ().
  %% The lead is slow and no lane is free: I follow it.
  keep_lead [dyn] : $busy * $tick__grant(planner, controls) * $lead_slow * $keep_ok * go -o ()  @w 0.01.
  %% The lead is closing in on me: I ease off, {R}.
  brake_follow [dyn] : $busy * $tick__grant(planner, controls) * $keep_no * $soft(R) * go -o ().
}
%% The plan is made: the next beat starts with safety.
qui back [dyn] : progress -o safety.
