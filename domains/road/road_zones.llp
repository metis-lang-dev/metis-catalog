% CHARIOT CANONICAL — corridor-intersection + zipper-merge semantics,
% LIFTED (catalog-reconciliation P2): the py-DSL registry generated
% these as ~10^3 ground rules per zone (rss/catalog/road.py,
% conflict_zone_rules / zipper_merge_rules — the referee); here the
% same semantics is seven relations-only rules per family, every
% number in compiler-generated Horn tables (roadcat.zonecat), the
% action choice priced by one port. The ad-rss reduction throughout:
% a crossing is never 2D geometry — an occupancy token plus per-
% approach 1D distance-to-enter counters.
%
% Tables (instance-emitted): actv (action/speed transition lattice),
% still/reach (the branch of dist vs post-action speed; the referee's
% third "stopped at the line" branch is unreachable for dist >= 1 and
% is dropped here), crossing (which axes intersect), osucc/odec (the
% occupancy counter lattice), flip (zipper alternation). Facts:
% approach (who nears which zone on which axis), merges (who merges
% on which side).
%
% The RSS zone-entry veto ("a non-priority approacher must retain the
% ability to stop before the line") is the declared guard port zentry
% — bound python-side for admission model checks (roadcat.checks),
% C++-side at the planner seam.
catalog road-zones 1.
provenance hand "lifted recode of the registry conflict-zone/zipper schemas (rss/catalog/road.py)" "2026-07-24".
layers (dyn).
stages (step).

namespace zone produce (dyn).

pred tok(car) : zone.
pred spd(car,speed) : zone.
pred dz(car,zn,dist) : zone.
pred inz(car,zn) : zone.
pred czfree(zn) : zone.
pred czaxis(zn,axis) : zone.
pred cnt(zn,occ) : zone.
pred mfree(zn) : zone.
pred mheld(zn) : zone.
pred zip(zn,side) : zone.
pred clear(zn,side) : zone.
pred past(car,zn) : zone.
pred run : zone.
pred crash : zone.

bwd approach(car,zn,axis).
bwd merges(car,zn,side).
bwd actv(act,speed,speed).
bwd still(dist,speed,dist).
bwd reach(dist,speed).
bwd crossing(axis,axis).
bwd osucc(occ,occ).
bwd odec(occ,occ).
bwd flip(side,side).

input scene.
output maneuver.

weight zmove(car,act).

guard zentry(car,zn).

stage step {
  %% approach: still short of the entry line after moving at the
  %% post-action speed — the distance counter decrements by it.
  zapp [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * $run
    * approach(C,Z,A) * actv(Act,V,V2) * still(N,V2,N2)
    -o spd(C,V2) * dz(C,Z,N2)  @w zmove(C,Act).
  %% first entry claims the zone for this approach's axis and starts
  %% the occupancy counter.
  zenter [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * czfree(Z) * cnt(Z,0)
    * $run * approach(C,Z,A) * actv(Act,V,V2) * reach(N,V2)
    -o spd(C,V2) * inz(C,Z) * czaxis(Z,A) * cnt(Z,1)  @w zmove(C,Act).
  %% same-axis entry shares the held zone (partial clearance): only
  %% the holding axis's token can be consumed — exclusivity is by
  %% consumption, not by check.
  zshare [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * czaxis(Z,A) * cnt(Z,K)
    * $run * approach(C,Z,A) * actv(Act,V,V2) * reach(N,V2) * osucc(K,K2)
    -o spd(C,V2) * inz(C,Z) * czaxis(Z,A) * cnt(Z,K2)  @w zmove(C,Act).
  %% entry while a CROSSING axis holds the zone IS the crash — the
  %% fully-blocking core of the ad-rss reduction.
  zram [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * czaxis(Z,A2) * run
    * approach(C,Z,A) * actv(Act,V,V2) * reach(N,V2) * crossing(A,A2)
    -o crash  @w zmove(C,Act).
  %% the LAST exit returns the zone token; traversal took one tick.
  zexitlast [dyn] : tok(C) * spd(C,V) * inz(C,Z) * czaxis(Z,A) * cnt(Z,1)
    * $run * approach(C,Z,A)
    -o spd(C,V) * czfree(Z) * cnt(Z,0) * past(C,Z).
  %% a non-last exit decrements the occupancy counter, axis held.
  zexit [dyn] : tok(C) * spd(C,V) * inz(C,Z) * czaxis(Z,A) * cnt(Z,K)
    * $run * approach(C,Z,A) * odec(K,K2)
    -o spd(C,V) * czaxis(Z,A) * cnt(Z,K2) * past(C,Z).

  %% zipper approach: same three-way branch over the merge zone.
  mapp [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * $run
    * merges(C,Z,S) * actv(Act,V,V2) * still(N,V2,N2)
    -o spd(C,V2) * dz(C,Z,N2)  @w zmove(C,Act).
  %% entry from the token side FLIPS the alternation token — priorite
  %% par alternance as an invariant, zero-message coordination.
  menter [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * mfree(Z) * zip(Z,S)
    * $run * merges(C,Z,S) * actv(Act,V,V2) * reach(N,V2) * flip(S,S2)
    -o spd(C,V2) * inz(C,Z) * mheld(Z) * zip(Z,S2)  @w zmove(C,Act).
  %% out-of-turn entry only against a perception-minted clear token
  %% for the empty other side (no negative conditions in LL) — the
  %% alternation token KEEPS its side.
  mskip [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * mfree(Z)
    * $zip(Z,S2) * $clear(Z,S2) * $run
    * merges(C,Z,S) * actv(Act,V,V2) * reach(N,V2) * flip(S,S2)
    -o spd(C,V2) * inz(C,Z) * mheld(Z)  @w zmove(C,Act).
  %% entry while the box is held IS the crash.
  mram [dyn] : tok(C) * spd(C,V) * dz(C,Z,N) * mheld(Z) * run
    * merges(C,Z,S) * actv(Act,V,V2) * reach(N,V2)
    -o crash  @w zmove(C,Act).
  %% exit frees the merge box after the one-tick traversal.
  mexit [dyn] : tok(C) * spd(C,V) * inz(C,Z) * mheld(Z)
    * $run * merges(C,Z,S)
    -o spd(C,V) * mfree(Z) * past(C,Z).
}

%% the step stage cycles on itself: every firing is one actor-tick.
qui tick [dyn] : step -o step.
