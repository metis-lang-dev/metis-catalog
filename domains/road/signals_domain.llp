% signals_domain — the road's lights, a member of its own (road-agent s-357becc7, the user's word: it runs in parallel with the plan
% and the proper response): it beats at the world's step, so a light's change is read within 0.1 s and not at the plan's next second,
% and holds the controls by priority: the proper response over it, it over the plan. A red, or an amber I can still stop for, ahead and
% near: I take the controls and stop before the line, and a stop begun is held to the line; a green or no light: I hand them back. Red and
% amber together wait as red does. Too late to stop is the amber's exception, with its margin, can_stop (Convention on Road Signs Art.
% 23(1)(a)(iii)); a red asks more: only a stop the brakes cannot make is excused, can_halt. Once over the line the host says no light ahead, so a car in the junction clears it (Convention on Road Traffic Art. 18(6)). A green gives no right to enter
% (Art. 18(5)) and suppresses no response: the responder stays over this member. The light is read from the host (signal(nextzone, L));
% the lights are the world's truth, not sensed.
catalog signals_domain 1.
provenance text "the road's lights: stop before the line at a red, and at an amber if I can; hand the controls back on a green" "2026-11-01".
layers (dyn).
stages (act).
types (zone zclass).   % completed by the instance (capacity.llp)
include "iface/protocol_domain.llp".
type light {green green_yield amber red off}.
namespace signals produce (dyn).
% the host's classes (metis-worlds road/world/road_facts.py)
pred signal(zone, light) : signals.         % the light on the next link of the way; off with none, or inside the junction
pred zone_at(zone, zclass) : signals.
pred can_stop(zone) : signals.
pred can_halt(zone) : signals.              % the line is within the hardest braking
pred now : signals.                         % the host's beat: one command a tick
% its own
pred idle : signals.
pred busy : signals.
bwd closing_in(zclass).
closing_in(near).
closing_in(at).
bwd goes(light).                            % the lights that ask nothing of me
goes(green).
goes(green_yield).
goes(off).
stage act {
  %% The light ahead is red and my brakes can stop me before its line: I take the controls.
  guard_red [dyn] : $signal(nextzone, red) * $can_halt(nextzone) * $zone_at(nextzone, C) * $closing_in(C) * idle -o busy * tick__active(signals) * tick__want(signals, controls).
  %% The light ahead is amber and I can stop before its line: I take the controls.
  guard_amber [dyn] : $signal(nextzone, amber) * $can_stop(nextzone) * $zone_at(nextzone, C) * $closing_in(C) * idle -o busy * tick__active(signals) * tick__want(signals, controls).
  % >>> generated by metis.catalog.protocol_stub: the stop's cancels and the release's echo (regenerate, do not edit)
  %% Stopped: I drop my goal.
  cancel [dyn] : tick__cancel(signals) * busy -o idle.
  %% Stopped as I finished: nothing left to drop.
  cancel_none [dyn] : idle * tick__cancel(signals) -o idle.   % the race: its done and the stop in one director beat (path_pop, stop_cancel: the sampled order)
  %% I gave {R} back: I say which grant.
  released [dyn] : tick__release(signals, R) * $tick__gen(signals, R, G) -o tick__released(signals, R, G).
  % <<< generated
  %% The light ahead is red: I stop before its line.
  yield_red [dyn] : $busy * $tick__grant(signals, controls) * $signal(nextzone, red) * now -o ().
  %% The light ahead is amber and I began to stop: I stop before its line.
  yield_amber [dyn] : $busy * $tick__grant(signals, controls) * $signal(nextzone, amber) * now -o ().
  %% The light lets me go: the plan has the controls again.
  light_clear [dyn] : busy * $signal(nextzone, L) * $goes(L) -o idle * tick__done(signals) * tick__release(signals, controls).
}
