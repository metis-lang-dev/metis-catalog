input grid.
output action.
weight life(C) reads {force(C), pa(C), pa(D) if adj(C,D)}.
stage mark {
  %% snapshot an alive cell.
  mr [dyn] : m(I) * a(C) * cidx(C,I) * succ(I,I2) -o pa(C) * tok(C) * m(I2).
  %% snapshot a dead cell.
  md [dyn] : m(I) * d(C) * cidx(C,I) * succ(I,I2) -o pd(C) * tok(C) * m(I2).
}
stage update {
  %% was alive, stays alive.
  up [dyn] : u(I) * tok(C) * $pa(C) * cidx(C,I) * succ(I,I2) -o na(C) * u(I2)  @w life(C).
  %% was alive, dies.
  dn [dyn] : u(I) * tok(C) * $pa(C) * cidx(C,I) * succ(I,I2) -o nd(C) * u(I2)  @w ~life(C).
  %% was dead, is born.
  rv [dyn] : u(I) * tok(C) * $pd(C) * cidx(C,I) * succ(I,I2) -o na(C) * u(I2)  @w life(C).
  %% was dead, stays dead.
  st [dyn] : u(I) * tok(C) * $pd(C) * cidx(C,I) * succ(I,I2) -o nd(C) * u(I2)  @w ~life(C).
}
stage sweep {
  %% commit: was alive, next alive.
  swaa [dyn] : s(I) * pa(C) * na(C) * cidx(C,I) * succ(I,I2) -o a(C) * s(I2).
  %% commit: was alive, next dead.
  swad [dyn] : s(I) * pa(C) * nd(C) * cidx(C,I) * succ(I,I2) -o d(C) * s(I2).
  %% commit: was dead, next alive.
  swda [dyn] : s(I) * pd(C) * na(C) * cidx(C,I) * succ(I,I2) -o a(C) * s(I2).
  %% commit: was dead, next dead.
  swdd [dyn] : s(I) * pd(C) * nd(C) * cidx(C,I) * succ(I,I2) -o d(C) * s(I2).
}
%% snapshot done -> update pass.
qui mu [dyn] : mark * m(i9) -o update * u(i0).
%% update done -> commit.
qui us [dyn] : update * u(i9) -o sweep * s(i0).
%% committed -> next tick.
qui sm [dyn] : sweep * s(i9) -o mark * m(i0).
