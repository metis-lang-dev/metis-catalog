% SOURCE: rddlrepository Tamarisk_MDP_ippc2014 — archive/competitions/IPPC2014/Tamarisk/MDP/domain.rddl, header lines 1-39 verbatim (read as latin-1: the 0x96 in the page range is kept as U+0096, cp1252's en-dash):
% ///////////////////////////////////////////////////////////////
% //
% // Invasive Species (Tamarisk) Domain 
% //
% // This is adapted from the RL Competition 2014 Invasive Species domain 
% //
% //   https://slots.google.com/slot/rlcompetition2014/domains/invasive-species 
% //
% // by Majid Alkaee Taleghan, Mark Crowley, and Thomas Dietterich 
% // of Oregon State University, who have investigated reinforcement learning
% // for this domain in 
% //
% //   Dietterich, T., Taleghan, M., Crowley, M. (2013). 
% //   PAC Optimal Planning for Invasive Species Management: 
% //     Improved Exploration for Reinforcement Learning from Simulator-Defined MDPs. 
% //   In Proceedings of the AAAI Conference on Artificial Intelligence, AAAI-13.
% //
% // and based their Invasive Species (Tamarisk) model on the following work 
% //
% //   Muneepeerakul, R., Weitz, J. S., Levin, S. a, Rinaldo, A., & Rodriguez-Iturbe, I. (2007). 
% //   A neutral metapopulation model of biodiversity in river networks. 
% //   Journal of theoretical biology, 245(2), 35163.
% //
% // Quick explanation: a stream system is organized into reaches with
% // slots at each reach.  Each slot may have a native plot or invasive
% // tamarisk plant (or be empty).  Tamarisk plants spread downstream
% // and sometimes upstream and compete to replace native species that
% // spread at a fixed rate.  One can manually intervene to eradicate
% // tamarisk plants at a reach or restore them to their native species.
% // Costs are assessed for eradication and restorative actions based on
% // the amount of work that has to be done and penalties are assessed
% // for invaded or vulnerable reaches.
% //
% // NOTE: this is a variation of the domain defined in the citations
% //       above, points of variation or interpretation are noted below.
% //
% // RDDL translation by Scott Sanner (ssanner@gmail.com).
% //
% ///////////////////////////////////////////////////////////////
%
% Assembled 2026-10-11 from metis-loop experiments/tamarisk (subject
% rddl-tier1, step 2): the loop's iteration-1 world, accepted in the metis
% shell from episodes of instance 1 (4 reaches x 2 slots; the instance is
% data below). Every rate is a global weight port (one per law), bound at
% serve time: the base binding is prior-flat (experiments/tamarisk/
% tamarisk_plugin.py) and the fitted table is the episode notch
% (notch_slots.py). Ground truth for the notch = the domain's DYNAMICS
% non-fluents: ERADICATION-RATE 0.9 (perad), RESTORATION-RATE 0.9 (prest),
% DOWNSTREAM-SPREAD-RATE 0.6 (pdown, and psib: the cpfs use the same rate
% within a reach), UPSTREAM-SPREAD-RATE 0.15 (pup), DEATH-RATE-TAMARISK
% 0.05 (ptdie), DEATH-RATE-NATIVE 0.05 (pndie), EXOGENOUS-PROD-RATE-TAMARISK
% 0.1 (ptborn), EXOGENOUS-PROD-RATE-NATIVE 0.1 (pnborn),
% COMPETITION-WIN-RATE-TAMARISK 0.8 (ptcomp), COMPETITION-WIN-RATE-NATIVE
% 0.2 (pncomp).
catalog tamarisk 2.
provenance text "Observed tamarisk river (rddlrepository Tamarisk_MDP_ippc2014, instance 1): synchronous per-slot tamarisk and native dynamics under eradicate/restore" "2026-10-11".
layers (dyn).
stages (snap rouse act fate write).
% the instance is data: four reaches, two slots per reach, as observed
type reach {r1 r2 r3 r4}.
type slot {s1s1 s1s2 s2s1 s2s2 s3s1 s3s2 s4s1 s4s2}.
% scan positions: a path over every slot, ending at p9
type pos {p1 p2 p3 p4 p5 p6 p7 p8 p9}.
namespace tr produce (dyn).
% observed fluents, actions and tick
pred tamarisk_at(slot) : tr.
pred not_tamarisk_at(slot) : tr.
pred native_at(slot) : tr.
pred not_native_at(slot) : tr.
pred eradicate(reach) : tr.
pred restore(reach) : tr.
pred tick : tr.
% the world's own atoms: the start-of-step snapshot, per-slot work, per-reach action flags
pred old_t(slot) : tr.
pred old_nt(slot) : tr.
pred old_n(slot) : tr.
pred old_nn(slot) : tr.
pred tdue(slot) : tr.
pred ndue(slot) : tr.
pred open(slot) : tr.
pred erad(reach) : tr.
pred noerad(reach) : tr.
pred rest(reach) : tr.
pred norest(reach) : tr.
pred scan(slot, pos) : tr.
pred set_t(slot) : tr.
pred set_nt(slot) : tr.
pred set_n(slot) : tr.
pred set_nn(slot) : tr.
bwd on(slot, reach).
on(s1s1, r1).
on(s1s2, r1).
on(s2s1, r2).
on(s2s2, r2).
on(s3s1, r3).
on(s3s2, r3).
on(s4s1, r4).
on(s4s2, r4).
% one slot per reach opens that reach's action flags
bwd lead(slot, reach).
lead(s1s1, r1).
lead(s2s1, r2).
lead(s3s1, r3).
lead(s4s1, r4).
% down(U, D): D is the reach just downstream of U
bwd down(reach, reach).
down(r1, r2).
down(r2, r3).
down(r3, r4).
% reaches neither equal nor adjacent
bwd apart(reach, reach).
apart(r1, r3).
apart(r3, r1).
apart(r1, r4).
apart(r4, r1).
apart(r2, r4).
apart(r4, r2).
bwd at(pos, slot).
at(p1, s1s1).
at(p2, s1s2).
at(p3, s2s1).
at(p4, s2s2).
at(p5, s3s1).
at(p6, s3s2).
at(p7, s4s1).
at(p8, s4s2).
bwd nxt(pos, pos).
nxt(p1, p2).
nxt(p2, p3).
nxt(p3, p4).
nxt(p4, p5).
nxt(p5, p6).
nxt(p6, p7).
nxt(p7, p8).
nxt(p8, p9).
bwd stop(pos).
stop(p9).
weight ptcomp reads {}.
weight pncomp reads {}.
weight perad reads {}.
weight ptdie reads {}.
weight pndie reads {}.
weight ptborn reads {}.
weight psib reads {}.
weight pdown reads {}.
weight pup reads {}.
weight prest reads {}.
weight pnborn reads {}.
stage snap {
  % evidence: "Every slot changes within ONE step, all at once, each by what held at the START of the step"
  %% [fold]
  snap_t [dyn] : tamarisk_at(S) -o old_t(S) * tdue(S) * open(S).
  % evidence: "Every slot changes within ONE step, all at once, each by what held at the START of the step"
  %% [fold]
  snap_nt [dyn] : not_tamarisk_at(S) -o old_nt(S) * tdue(S) * open(S).
  % evidence: "Every slot changes within ONE step, all at once, each by what held at the START of the step"
  %% [fold]
  snap_n [dyn] : native_at(S) -o old_n(S) * ndue(S).
  % evidence: "Every slot changes within ONE step, all at once, each by what held at the START of the step"
  %% [fold]
  snap_nn [dyn] : not_native_at(S) -o old_nn(S) * ndue(S).
}
stage rouse {
  % evidence: "plus the action atoms taken that step (zero or one: eradicate(R) or restore(R), R in r1 r2 r3 r4)"
  %% [fold]
  rouse_reach [dyn] : open(S) * lead(S, R) -o noerad(R) * norest(R).
}
stage act {
  % evidence: "eradicate on its reach"
  %% eradicate is applied on reach R.
  take_eradicate [dyn] : eradicate(R) * noerad(R) -o erad(R).
  % evidence: "restore on its reach"
  %% restore is applied on reach R.
  take_restore [dyn] : restore(R) * norest(R) -o rest(R).
  % evidence: "and one tick atom"
  %% [fold]
  take_tick [dyn] : tick -o ().
}
stage fate {
  % evidence: "(1) a slot holding both at the start is a competition: tamarisk stays with one rate and native stays with another, independently of each other, whatever the action"
  %% the tamarisk at S survives the competition with the native | the tamarisk at S dies out in the competition with the native
  t_compete [dyn] : tdue(S) * $old_t(S) * $old_n(S) -o (set_t(S) @w ptcomp | set_nt(S) @w ~ptcomp).
  % evidence: "(1) a slot holding both at the start is a competition: tamarisk stays with one rate and native stays with another, independently of each other, whatever the action"
  %% the native at S survives the competition with the tamarisk | the native at S dies out in the competition with the tamarisk
  n_compete [dyn] : ndue(S) * $old_t(S) * $old_n(S) -o (set_n(S) @w pncomp | set_nn(S) @w ~pncomp).
  % evidence: "(2) A slot holding tamarisk and no native: eradicate on its reach removes the tamarisk at a rate (sometimes it survives)"
  %% eradication on reach R removes the tamarisk at S | the tamarisk at S survives eradication on reach R
  t_eradicate [dyn] : tdue(S) * $old_t(S) * $old_nn(S) * on(S, R) * $erad(R) -o (set_nt(S) @w perad | set_t(S) @w ~perad).
  % evidence: "without eradicate on its reach the tamarisk sometimes dies by itself, at a rate"
  %% the tamarisk at S dies by itself | the tamarisk at S stays
  t_wither [dyn] : tdue(S) * $old_t(S) * $old_nn(S) * on(S, R) * $noerad(R) -o (set_nt(S) @w ptdie | set_t(S) @w ~ptdie).
  % evidence: "(2) A slot holding tamarisk and no native" — no native arrives where tamarisk stands alone
  %% no native arrives at S, where the tamarisk stands alone.
  n_under_tamarisk [dyn] : ndue(S) * $old_t(S) * $old_nn(S) -o set_nn(S).
  % evidence: "(3) A slot holding native and no tamarisk: restore on its reach keeps the native for sure"
  %% restore on reach R keeps the native at S.
  n_kept [dyn] : ndue(S) * $old_nt(S) * $old_n(S) * on(S, R) * $rest(R) -o set_n(S).
  % evidence: "otherwise the native sometimes dies by itself, at a rate"
  %% the native at S dies by itself | the native at S stays
  n_wither [dyn] : ndue(S) * $old_nt(S) * $old_n(S) * on(S, R) * $norest(R) -o (set_nn(S) @w pndie | set_n(S) @w ~pndie).
  % evidence: "(3) A slot holding native and no tamarisk" — no tamarisk arrives where native stands alone
  %% no tamarisk arrives at S, where the native stands alone.
  t_under_native [dyn] : tdue(S) * $old_nt(S) * $old_n(S) -o set_nt(S).
  % evidence: "(4) An empty slot, for tamarisk: with eradicate on its reach no tamarisk arrives that step"
  %% eradication on reach R keeps tamarisk out of the empty slot S.
  t_barred [dyn] : tdue(S) * $old_nt(S) * $old_nn(S) * on(S, R) * $erad(R) -o set_nt(S).
  % evidence: "otherwise tamarisk may arrive by itself (at a rate)"
  %% tamarisk arrives at the empty slot S by itself | no tamarisk arrives at S by itself, and the tamarisk nearby is tried as a source
  t_born [dyn] : tdue(S) * $old_nt(S) * $old_nn(S) * on(S, R) * $noerad(R) -o (set_t(S) @w ptborn | scan(S, p1) @w ~ptborn).
  % evidence: "EACH tamarisk at the start in the other slot of the same reach ... is a separate independent chance of seeding it"
  %% the tamarisk at X, in the same reach, seeds S | the tamarisk at X, in the same reach, does not seed S
  seed_sib [dyn] : scan(S, P) * at(P, X) * $old_t(X) * on(S, R) * on(X, R) * S <> X * nxt(P, Q) -o (set_t(S) @w psib | scan(S, Q) @w ~psib).
  % evidence: "a source upstream (spreading downstream)" "each has its own rate"
  %% the tamarisk at X, upstream, seeds S | the tamarisk at X, upstream, does not seed S
  seed_down [dyn] : scan(S, P) * at(P, X) * $old_t(X) * on(S, R) * on(X, U) * down(U, R) * nxt(P, Q) -o (set_t(S) @w pdown | scan(S, Q) @w ~pdown).
  % evidence: "a source downstream (spreading upstream, observed rarer)" "each has its own rate"
  %% the tamarisk at X, downstream, seeds S | the tamarisk at X, downstream, does not seed S
  seed_up [dyn] : scan(S, P) * at(P, X) * $old_t(X) * on(S, R) * on(X, D) * down(R, D) * nxt(P, Q) -o (set_t(S) @w pup | scan(S, Q) @w ~pup).
  % evidence: "in the other slot of the same reach, in a slot of the reach just upstream, or in a slot of the reach just downstream" — a slot without tamarisk at the start is no source
  %% [fold]
  pass_bare [dyn] : scan(S, P) * at(P, X) * $old_nt(X) * nxt(P, Q) -o scan(S, Q).
  % evidence: "in the other slot of the same reach, in a slot of the reach just upstream, or in a slot of the reach just downstream" — a farther tamarisk is no source
  %% [fold]
  pass_far [dyn] : scan(S, P) * at(P, X) * $old_t(X) * on(S, R) * on(X, U) * apart(R, U) * nxt(P, Q) -o scan(S, Q).
  % evidence: "the more such sources, the more often it arrives" — every source tried and none seeded: no tamarisk arrives
  %% no source seeded S: no tamarisk arrives there.
  seed_none [dyn] : scan(S, P) * stop(P) -o set_nt(S).
  % evidence: "(5) An empty slot, for native, independently of tamarisk: with restore on its reach a native arrives at a rate (sometimes restore fails)"
  %% restore on reach R plants a native at S | restore on reach R fails to plant a native at S
  n_planted [dyn] : ndue(S) * $old_nt(S) * $old_nn(S) * on(S, R) * $rest(R) -o (set_n(S) @w prest | set_nn(S) @w ~prest).
  % evidence: "otherwise a native sometimes arrives by itself, at a rate; tamarisk and native can arrive in the same step and then both are held"
  %% a native arrives at the empty slot S by itself | no native arrives at S
  n_born [dyn] : ndue(S) * $old_nt(S) * $old_nn(S) * on(S, R) * $norest(R) -o (set_n(S) @w pnborn | set_nn(S) @w ~pnborn).
}
stage write {
  % evidence: "The next state is read when nothing more can happen, and must again hold, for each observed fluent, exactly one of the atom or not_<atom>"
  %% [fold]
  write_t [dyn] : set_t(S) -o tamarisk_at(S).
  % evidence: "The next state is read when nothing more can happen, and must again hold, for each observed fluent, exactly one of the atom or not_<atom>"
  %% [fold]
  write_nt [dyn] : set_nt(S) -o not_tamarisk_at(S).
  % evidence: "The next state is read when nothing more can happen, and must again hold, for each observed fluent, exactly one of the atom or not_<atom>"
  %% [fold]
  write_n [dyn] : set_n(S) -o native_at(S).
  % evidence: "The next state is read when nothing more can happen, and must again hold, for each observed fluent, exactly one of the atom or not_<atom>"
  %% [fold]
  write_nn [dyn] : set_nn(S) -o not_native_at(S).
  % evidence: "a plant that arrives this step seeds nothing until the next" — the start-of-step snapshot is spent
  %% [fold]
  drop_t [dyn] : old_t(S) -o ().
  % evidence: "a plant that arrives this step seeds nothing until the next" — the start-of-step snapshot is spent
  %% [fold]
  drop_nt [dyn] : old_nt(S) -o ().
  % evidence: "a plant that arrives this step seeds nothing until the next" — the start-of-step snapshot is spent
  %% [fold]
  drop_n [dyn] : old_n(S) -o ().
  % evidence: "a plant that arrives this step seeds nothing until the next" — the start-of-step snapshot is spent
  %% [fold]
  drop_nn [dyn] : old_nn(S) -o ().
  % evidence: "the observed next state never depends on them"
  %% [fold]
  drop_open [dyn] : open(S) -o ().
  % evidence: "the observed next state never depends on them"
  %% [fold]
  drop_erad [dyn] : erad(R) -o ().
  % evidence: "the observed next state never depends on them"
  %% [fold]
  drop_noerad [dyn] : noerad(R) -o ().
  % evidence: "the observed next state never depends on them"
  %% [fold]
  drop_rest [dyn] : rest(R) -o ().
  % evidence: "the observed next state never depends on them"
  %% [fold]
  drop_norest [dyn] : norest(R) -o ().
}
% evidence: "a step starts from a state holding, for EACH observed fluent, either its atom (true) or not_<atom> (false)"
%% [fold]
qui snapped [dyn] : snap -o rouse.
% evidence: "plus the action atoms taken that step (zero or one: eradicate(R) or restore(R), R in r1 r2 r3 r4)"
%% [fold]
qui roused [dyn] : rouse -o act.
% evidence: "Every slot changes within ONE step, all at once, each by what held at the START of the step"
%% [fold]
qui acted [dyn] : act -o fate.
% evidence: "The next state is read when nothing more can happen"
%% [fold]
qui settled [dyn] : fate -o write.
% illustrative initial state
% scene: instance 1's initial state (tamarisk at s1s1, native at s1s1 s2s2 s3s1), no action
#init tamarisk_at(s1s1) 1
#init native_at(s1s1) 1
#init native_at(s2s2) 1
#init native_at(s3s1) 1
#init not_tamarisk_at(s1s2) 1
#init not_tamarisk_at(s2s1) 1
#init not_tamarisk_at(s2s2) 1
#init not_tamarisk_at(s3s1) 1
#init not_tamarisk_at(s3s2) 1
#init not_tamarisk_at(s4s1) 1
#init not_tamarisk_at(s4s2) 1
#init not_native_at(s1s2) 1
#init not_native_at(s2s1) 1
#init not_native_at(s3s2) 1
#init not_native_at(s4s1) 1
#init not_native_at(s4s2) 1
#init tick 1
#steps 200

#plugin tamarisk/tamarisk_plugin.py:make
#notch tamarisk.notch.json
