% Port of interactive-lp/examples/primes.cep — a sieve: generate
% 2..12, then let every number annihilate its multiples; what is left
% are the primes. Rule names kept; the anonymous `qui * stage gen -o
% stage primes` link is named `sieve`.
%
% Encodings (recipe rows "#builtin NAT / unary naturals" and
% "finite constructor terms"):
%   - nat is bounded to n0..n12 — the original's own limit is 12
%     (`% 12` above its context), so the bound costs nothing here; a
%     larger limit needs a larger range. The ground program is small
%     (73 events) but GROUNDING TIME is not: collide's 13^3
%     substitutions each re-prove mult/plus by untabled backward
%     chaining — load 0.5 s at limit 8, 5 s at 12, 30 s at 16
%     (measured 2026-10-03; reported upstream). Keep the limit at 12.
%   - `s` is the bwd successor graph s(X,SX); plus/z, plus/s, mult/z,
%     mult/s are the original's four Horn clauses. mult/s's subgoals
%     are ordered mult-then-plus so backward chaining binds the
%     intermediate product before adding (the original's `<-` chain
%     lists them plus-first; same relation, terminating order).
%   - plus/z and mult/z are FACTS WITH VARIABLES (`plus z N N`). An
%     LLP Horn fact's arguments are taken literally (a var in a fact
%     becomes the constant `N`, silently — reported upstream), so
%     they are written as rules over a membership relation isnat(N)
%     that enumerates the bounded nat: `plus(n0,N,N) :- isnat(N).`
%   - go's `limit (s (s N))` pattern is limit(SSN) with guards
%     s(SN,SSN), s(N,SN) — "at least two"; stop's `limit (s z)` is
%     limit(n1). `mult _ N M` takes the var X for `_`.
%
% $-OVERLAP SITE (tragedy-v3 caveat) — collide:
%     $here N * here M * mult _ N M -o ().
% With `_` = 1, mult(n1,N,N) makes M = N: the $-read and the consume
% name the SAME atom. Ceptre's $ claims its own token, so 1*N needs
% two here(N) tokens and never fires; a metis $-read claims none, so
% `$here(N) * here(N)` would let every number annihilate ITSELF —
% primes included, the sieve would empty. Written out as the
% consume-and-reproduce it denotes: `here(N) * here(M) * … -o
% here(N)`, which needs two tokens when M = N, exactly as in Ceptre.
% No pumping rules: every rule consumes.
catalog primes 1.
provenance hand "port:interactive-lp/examples/primes.cep" "2026-10-03".
layers (story).
stages (gen primes).
type nat {n0..n12}.
namespace sieve produce (story).
pred limit(nat) : sieve.
pred here(nat) : sieve.
bwd s(nat,nat).
bwd plus(nat,nat,nat).
bwd mult(nat,nat,nat).
bwd isnat(nat).
isnat(n0). isnat(n1). isnat(n2). isnat(n3). isnat(n4). isnat(n5).
isnat(n6). isnat(n7). isnat(n8). isnat(n9). isnat(n10). isnat(n11).
isnat(n12).
s(n0,n1).
s(n1,n2).
s(n2,n3).
s(n3,n4).
s(n4,n5).
s(n5,n6).
s(n6,n7).
s(n7,n8).
s(n8,n9).
s(n9,n10).
s(n10,n11).
s(n11,n12).
% plus/z : plus z N N.        plus/s : plus (s N) M (s P) <- plus N M P.
plus(n0,N,N) :- isnat(N).
plus(SN,M,SP) :- s(N,SN), s(P,SP), plus(N,M,P).
% mult/z : mult z N z.        mult/s : mult (s N) M P
%                                 <- plus NtimesM M P <- mult N M NtimesM.
mult(n0,N,n0) :- isnat(N).
mult(SN,M,P) :- s(N,SN), mult(N,M,NM), plus(NM,M,P).
stage gen {
  %% a limit of at least two puts that number here and counts down.
  go [story] : limit(SSN) * s(SN,SSN) * s(N,SN)
    -o here(SSN) * limit(SN).
  %% the countdown reaches one: generation ends.
  stop [story] : limit(n1) -o ().
}
%% all numbers generated -> annihilate multiples.
qui sieve [story] : gen -o primes.
stage primes {
  %% N annihilates its multiple M = X*N (N stays: written as the
  %% consume-and-reproduce of the original's $here N — see header).
  collide [story] : here(N) * here(M) * mult(X,N,M) -o here(N).
}
% context init = {limit 12} + `#trace _ gen init.`
#init limit(n12) 1
#steps 24
#seeds 3
#query here(n7)
#query here(n11)
#query here(n9)
#query here(n12)
